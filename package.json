{
  "name": "tsperf-type-lens",
  "displayName": "TSPerf Type Lens",
  "description": "Inspect TypeScript type-checker latency and structural complexity at the cursor.",
  "version": "0.1.0",
  "publisher": "eldwin-easynet-world",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/eldwin-easynet-world/tsperf-type-lens.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onCommand:tsperf.inspectTypeAtCursor",
    "onCommand:tsperf.benchmarkCurrentFile",
    "onCommand:tsperf.clearCache"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "tsperf.inspectTypeAtCursor",
        "title": "TSPerf: Inspect Type at Cursor"
      },
      {
        "command": "tsperf.benchmarkCurrentFile",
        "title": "TSPerf: Benchmark Current File"
      },
      {
        "command": "tsperf.clearCache",
        "title": "TSPerf: Clear Measurement Cache"
      }
    ],
    "configuration": {
      "title": "TSPerf Type Lens",
      "properties": {
        "tsperf.maxDepth": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 8,
          "description": "Maximum recursive depth for type complexity scoring."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "watch": "tsc -watch -p .",
    "package": "vsce package --no-dependencies",
    "check": "tsc -p . --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^2.15.0",
    "typescript": "^5.5.4"
  },
  "dependencies": {}
}
